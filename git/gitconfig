[user]
	email = asheidan@gmail.com
	name = Emil Eriksson
[core]
	excludesfile = /Users/emil/.gitignore
[alias]
	co = checkout
	st = status -sb
	sw = switch

	authors = shortlog -sne
	sha = rev-parse --verify HEAD
	top-level = rev-parse --show-toplevel
	tree = log --oneline --graph --decorate
	unmerged = branch --no-merged

	branch-log = !zsh -c 'git log $(git last-common ${*})..${2:-HEAD}' -
	l = log --graph --decorate --pretty=format:'%C(bold magenta)%h%Creset %C(yellow)%ae%Creset %C(cyan)%ai%Creset %C(auto)%D%Creset%n%s%n' --all -15 --ancestry-path=HEAD~10
	last-common = !zsh -c 'diff --old-line-format='' --new-line-format='' <(git rev-list --first-parent "${1:-development}") <(git rev-list --first-parent "${2:-HEAD}") | head -1' -
	orphans = !git branch -vv | grep \": gone\" | cut -c3- | cut -d\" \" -f1
	search = "!f() { git grep \"$@\" $(git rev-list --all); }; f"
[init]
	defaultBranch = main
[pull]
	ff = only
[diff]
	tool = vimdiff
[color]
	diff = auto
	status = auto
	branch = auto
	interactive = auto
	ui = auto
[color "decorate"]
	branch = magenta
	remoteBranch = blue
	current = magenta bold
	HEAD = magenta bold
	tag = blue bold
	stash = yellow
	grafted = green
[color "branch"]
	current = magenta bold
	remote = blue
	local = magenta
	upstream = blue bold
	plain = green
