[user]
	email = asheidan@gmail.com
	name = Emil Eriksson
[core]
	excludesfile = /Users/emil/.gitignore
[alias]
	co = checkout
	st = status -sb
	sw = switch

	authors = shortlog -sne
	sha = rev-parse --verify HEAD
	top-level = rev-parse --show-toplevel
	tree = log --oneline --graph --decorate
	unmerged = branch --no-merged

	branch-log = !zsh -c 'git log $(git last-common ${*})..${2:-HEAD}' -
	l = log --graph --decorate --pretty=jj --all -15 --ancestry-path=HEAD~10
	lg = log --graph --decorate --pretty=jj
	last-common = !bash -c 'diff --old-line-format='' --new-line-format='' <(git rev-list --first-parent "${1:-main}") <(git rev-list --first-parent "${2:-HEAD}") | head -1' -
	orphans = !git branch -vv | grep \": gone\" | cut -c3- | cut -d\" \" -f1
	search = "!f() { git grep \"$@\" $(git rev-list --all); }; f"
	largest-blobs = "!f() { if [ -t 1 ]; then printf \"\\e[7m%-40s %-7s %-30s\\e[0m\n\" SHA SIZE PATH; fi; git rev-list --objects --all | git cat-file --batch-check=\"%(objecttype) %(objectname) %(objectsize) %(rest)\" | sed -n \"s/^blob //p\" | sort -n --key=2 --reverse | head -n \"${1:-10}\" | numfmt --field=2 --to=iec-i --suffix=B --padding=7 --round=nearest; }; f"
[init]
	defaultBranch = main
[pull]
	ff = only
[diff]
	tool = vimdiff
[color]
	diff = auto
	status = auto
	branch = auto
	interactive = auto
	ui = auto
[color "decorate"]
	branch = magenta
	remoteBranch = blue
	current = magenta bold
	HEAD = magenta bold
	tag = blue bold
	stash = yellow
	grafted = green
[color "branch"]
	current = magenta bold
	remote = blue
	local = magenta
	upstream = blue bold
	plain = green
[pretty]
	jj = format:%C(bold magenta)%h%Creset %C(yellow)%ae%Creset %C(cyan)%ai%Creset %C(auto)%D %gD%Creset%n%s%n
